rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isParticipant(chatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && get(/databases/$(database)/documents/chats/$(chatId)).data.participants is list
        && get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
    }

    // Private profile: users can read/write only their own profile.
    // Do not store a public phone-number directory here.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // Direct and group chat metadata is visible only to its members.
    match /chats/{chatId} {
      allow read: if signedIn()
        && resource.data.participants is list
        && resource.data.participants.hasAny([request.auth.uid]);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['participants', 'createdAt', 'type'])
        && request.resource.data.participants is list
        && request.resource.data.participants.hasAny([request.auth.uid])
        && request.resource.data.participants.size() >= 2
        && request.resource.data.participants.size() <= 100
        && request.resource.data.type in ['direct', 'group'];
      allow update: if signedIn()
        && resource.data.participants.hasAny([request.auth.uid])
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastCiphertext', 'lastUpdatedAt']);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isParticipant(chatId);
        // Store encrypted payloads only; plaintext message fields are rejected.
        allow create: if isParticipant(chatId)
          && request.resource.data.keys().hasOnly([
            'senderUid', 'ciphertext', 'nonce', 'createdAt', 'kind', 'keyVersion'
          ])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.ciphertext is string
          && request.resource.data.ciphertext.size() > 0
          && request.resource.data.ciphertext.size() <= 20000
          && request.resource.data.nonce is string
          && request.resource.data.nonce.size() <= 256
          && request.resource.data.kind in ['text', 'image', 'audio', 'file']
          && request.resource.data.keyVersion is int;
        allow update, delete: if false;
      }
    }

    // Legacy shared-room messaging is intentionally disabled to prevent
    // accidental exposure of private messages to every authenticated user.
    match /rooms/{roomId}/{document=**} {
      allow read, write: if false;
    }
  }
}