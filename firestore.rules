rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // MVP shared room: only authenticated users can read or post.
    // This room is intentionally public to all signed-in app users.
    match /rooms/general/messages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['senderUid', 'senderEmail', 'text', 'createdAt', 'kind'])
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 4000
        && request.resource.data.kind == 'text';
      allow update, delete: if false;
    }
  }
}
