rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() >= 1;
      allow update: if signedIn() && request.auth.uid in resource.data.memberUids
        && request.resource.data.memberUids == resource.data.memberUids;
      allow delete: if false;
      match /messages/{messageId} {
        function isMember() {
          return signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberUids;
        }
        allow read: if isMember();
        allow create: if isMember()
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['senderUid', 'text', 'createdAt', 'kind', 'mediaUrl'])
          && request.resource.data.kind in ['text', 'image', 'audio', 'file'];
        allow update, delete: if false;
      }
    }
  }
}